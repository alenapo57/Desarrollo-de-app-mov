# Base de datos en Neon (cloud). Copiá la connection string desde el panel de Neon
# (Connect → psycopg2 / connection string). Tiene que incluir ?sslmode=require
DATABASE_URL=postgresql://usuario:password@ep-xxxx-xxxx.sa-east-1.aws.neon.tech/neondb?sslmode=require&channel_binding=require

# Alternativa: Postgres local
# DATABASE_URL=postgresql://usuario:password@localhost:5432/financontrol

SECRET_KEY=reemplazar-por-una-clave-secreta-larga-y-aleatoria
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=10080
